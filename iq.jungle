# IQ Store / distribution build.
# Uses manifest-iq.xml (different app ID from manifest.xml).
# Does NOT include resources-livetest — the published widget has no baked-in
# clientId; users supply their own via the Garmin Connect app settings.
project.manifest = manifest-iq.xml

# ── Capability tiers (keep in sync with monkey.jungle) ──────────────────────
# base (API < 6.0 "legacy") — manual-only scheduling; no updateMode setting.
# The seven API 6.0+ "full" devices keep all update modes.
# NOTE: device-level values REPLACE base values for that key (override, not merge).
base.sourcePath = source
base.resourcePath = resources;resources-modes-legacy
base.excludeAnnotations = bgPoll

fenix843mm.excludeAnnotations = manualOnly
fenix843mm.resourcePath = resources;resources-modes-full
fenix847mm.excludeAnnotations = manualOnly
fenix847mm.resourcePath = resources;resources-modes-full
fenix8pro47mm.excludeAnnotations = manualOnly
fenix8pro47mm.resourcePath = resources;resources-modes-full
fenix8solar47mm.excludeAnnotations = manualOnly
fenix8solar47mm.resourcePath = resources;resources-modes-full
fenix8solar51mm.excludeAnnotations = manualOnly
fenix8solar51mm.resourcePath = resources;resources-modes-full
fenixe.excludeAnnotations = manualOnly
fenixe.resourcePath = resources;resources-modes-full
fr970.excludeAnnotations = manualOnly
fr970.resourcePath = resources;resources-modes-full
