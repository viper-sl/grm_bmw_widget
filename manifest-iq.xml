<?xml version="1.0"?>
<!-- IQ Store / distribution manifest. Different app ID from manifest.xml
     (local/personal sideload) so both can coexist on the same watch.
     TEMPLATE: this id is the BETA app. build-personal.sh (iqprod mode) swaps in the prod id
     (IQ_PROD_ID) in a throwaway copy — keep the id attribute on <iq:application>.
     DEVICES: The IQ package builder requires every listed device to have its
     SDK profile installed locally via the Connect IQ SDK Manager.
     35 profiles are declared below — the remaining 14 (below, commented) need
     SDK Manager → Devices first, then un-comment their <iq:product> lines.
     NOTE: API 6.0+ devices also need their tier stanzas in iq.jungle
     (fenix 8 / 9 families, fenixe, fr970, enduro3/4, marq3 already have them);
     map-less devices (fr255, fr255m, fr265) need their mapPage line there too. -->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
  <iq:application entry="BmwWidgetApp"
                  id="0a54403f6fef458a96fca6f8a147f299"
                  launcherIcon="@Drawables.LauncherIcon"
                  minSdkVersion="3.4.0"
                  name="@Strings.AppName"
                  type="widget">
    <iq:products>
      <!-- ── Installed locally (build works now) ── -->
      <!-- fēnix® 6 family. Base fenix6 (6 / 6 Solar / 6 Dual Power) is NOT supported:
           its widget limit is 64 KB with no code paging, the app no longer loads there
           ("Out Of Memory — Failed loading application", 61 KB available) and monkeyc
           refuses the build. Dropped 2026-11-05. -->
      <iq:product id="fenix6pro"/>
      <iq:product id="fenix6xpro"/>
      <!-- fēnix® 7 family -->
      <iq:product id="fenix7"/>
      <iq:product id="fenix7s"/>
      <iq:product id="fenix7x"/>
      <iq:product id="fenix7pro"/>
      <iq:product id="fenix7spro"/>
      <iq:product id="fenix7xpro"/>
      <iq:product id="fenix7pronowifi"/>
      <iq:product id="fenix7xpronowifi"/>
      <!-- fēnix® 8 / E family (full tier — stanzas in iq.jungle) -->
      <iq:product id="fenix843mm"/>
      <iq:product id="fenix847mm"/>
      <iq:product id="fenix8pro47mm"/>
      <iq:product id="fenix8solar47mm"/>
      <iq:product id="fenix8solar51mm"/>
      <iq:product id="fenixe"/>
      <!-- fēnix® 9 family (full tier — stanzas in iq.jungle) -->
      <iq:product id="fenix947mm"/>
      <iq:product id="fenix9pro47mm"/>
      <iq:product id="fenix9pro51mm"/>
      <iq:product id="fenix9prosolar47mm"/>
      <iq:product id="fenix9prosolar51mm"/>
      <!-- epix™ (Gen 2) / Pro — API 5.2, legacy tier, map page -->
      <iq:product id="epix2"/>
      <iq:product id="epix2pro42mm"/>
      <iq:product id="epix2pro47mm"/>
      <iq:product id="epix2pro51mm"/>
      <!-- Enduro™ 3/4 — API 6.0, full tier (stanzas in iq.jungle). Enduro gen 1 is
           NOT supported: 64 KB widget limit, no code paging (same as base fenix6). -->
      <iq:product id="enduro3"/>
      <iq:product id="enduro4"/>
      <!-- MARQ® -->
      <iq:product id="marq2"/>
      <iq:product id="marq3"/>
      <!-- Forerunner® -->
      <iq:product id="fr255"/>
      <iq:product id="fr255m"/>
      <iq:product id="fr265"/>
      <iq:product id="fr955"/>
      <iq:product id="fr965"/>
      <iq:product id="fr970"/>

      <!-- ── Install SDK profile to enable (SDK Manager → Devices) ──
      fēnix® 6 family (fenix6s = base 6S: almost certainly the same 64 KB widget limit as
      base fenix6 — check its compiler.json before enabling; fenix6spro is fine):
      <iq:product id="fenix6s"/>
      <iq:product id="fenix6spro"/>
      MARQ®:
      <iq:product id="marqadventurer"/>
      <iq:product id="marqathlete"/>
      <iq:product id="marqaviator"/>
      <iq:product id="marqcaptain"/>
      <iq:product id="marqcommander"/>
      <iq:product id="marqdriver"/>
      <iq:product id="marqexpedition"/>
      <iq:product id="marqgolfer"/>
      <iq:product id="marq2aviator"/>
      Forerunner®:
      <iq:product id="fr745"/>
      <iq:product id="fr945"/>
      <iq:product id="fr945lte"/>
      ── -->
    </iq:products>
    <iq:permissions>
      <iq:uses-permission id="Communications"/>
      <iq:uses-permission id="Background"/>
    </iq:permissions>
    <iq:languages>
      <iq:language>eng</iq:language>
    </iq:languages>
  </iq:application>
</iq:manifest>
