<?xml version="1.0"?>
<settings>

  <!-- ── Required ────────────────────────────────────────────────────── -->
  <group id="required" title="@Strings.GroupRequired">
    <setting propertyKey="@Properties.clientId" title="@Strings.ClientIdLabel">
      <settingConfig type="alphaNumeric"/>
    </setting>
  </group>

  <!-- ── Optional ─────────────────────────────────────────────────────
       VIN, containerId and refreshToken are auto-discovered on first run.
       Tank size and update mode control widget behaviour.              -->
  <group id="optional" title="@Strings.GroupOptional">
    <setting propertyKey="@Properties.vin" title="@Strings.VinLabel">
      <settingConfig type="alphaNumeric"/>
    </setting>
    <setting propertyKey="@Properties.containerId" title="@Strings.ContainerIdLabel">
      <settingConfig type="alphaNumeric"/>
    </setting>
    <setting propertyKey="@Properties.refreshToken" title="@Strings.RefreshTokenLabel">
      <settingConfig type="alphaNumeric"/>
    </setting>
    <setting propertyKey="@Properties.tankLitres" title="@Strings.TankLitresLabel">
      <settingConfig type="numeric" min="20" max="120"/>
    </setting>
    <setting propertyKey="@Properties.updateMode" title="@Strings.UpdateModeLabel">
      <settingConfig type="list">
        <listEntry value="0">@Strings.UpdateModeManual</listEntry>
        <listEntry value="1">@Strings.UpdateModeAuto</listEntry>
        <listEntry value="2">@Strings.UpdateModeAdaptive</listEntry>
      </settingConfig>
    </setting>
    <setting propertyKey="@Properties.nextMaintenanceKm" title="@Strings.NextMaintenanceLabel">
      <settingConfig type="numeric" min="0" max="50000"/>
    </setting>
  </group>

</settings>
